{
  "name": "v-viewer-test",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:vue2": "pnpm --filter @viewer-test/vue2 dev",
    "dev:vue3": "pnpm --filter @viewer-test/vue3 dev",
    "dev:nuxt": "pnpm --filter @viewer-test/nuxt dev",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "preview": "pnpm -r --parallel preview",
    "test": "pnpm run build && pnpm run test:e2e",
    "test:e2e": "playwright test",
    "test:headed": "playwright test --headed",
    "verify:dependencies": "node scripts/check-installed.mjs",
    "check": "pnpm run lint && pnpm run verify:dependencies && pnpm run typecheck && pnpm test",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "prettier": "3.9.9"
  }
}
